<script type="text/javascript" language="javascript">


 $(document).ready(function(){
	$('#searching').hide(); 
	$('#loadingcal').hide(); 
	$('#screendiv').hide(); 
}); 




$('#calsrch').submit(function(){ 
	//alert("hey");
    var isFormValid = true;
	
	var checkdate = $.trim($('#d').val());
	var checkloc = $.trim($('#loc').val());

	var t = $.trim($('#t').val());
	var c = $.trim($('#c').val());
	var p = $.trim($('#p').val());
	var j = $.trim($('#j').val());

	var f = $.trim($('#f').val());
	var l = $.trim($('#l').val());
	var b = $.trim($('#b').val());
	
//check if there are at least 4 numbers in case search
 	if (t == "c") { 
		if (checkdate !== "all" && checkloc == "all") {
			if (c.length < 3){ 
					isFormValid = false;
					$("#c").focus();
				}
				else{
				$(".screendiv").slideFadeToggle();
				$("#searching").slideFadeToggle("fast");
				}
			if (!isFormValid) alert("1:You must enter at least 3 digits of the case number --or-- select a location to search.");
			//if (!isFormValid) alert("Please enter at least 3 digits of the case number to search.");
			return isFormValid;
			}
		if (checkdate == "all" && checkloc == "all") {
			if (c.length < 3){ 
					isFormValid = false;
					$("#c").focus();
				}
				else{
				$(".screendiv").slideFadeToggle();
				$("#searching").slideFadeToggle("fast");
				}
			if (!isFormValid) alert("2:You must enter at least 3 digits of the case number --or-- select a location to search.");
			//if (!isFormValid) alert("Please enter at least 3 digits of the case number to search.");
			return isFormValid;
		}
		else {
			$(".screendiv").slideFadeToggle();
			$("#searching").slideFadeToggle("fast");
		}
	} 
		
//check if there are at least 2 characters in party search
	 if (t == "p") { 
			if (p.length < 2){ 
				isFormValid = false;
				$("#p").focus();
			}
			else{
				$(".screendiv").slideFadeToggle();
				$("#searching").slideFadeToggle("fast");
			}
		if (!isFormValid) alert("Please enter at least 2 letters of the party name.");
		return isFormValid;
		}
		
//check if there are at least 2 characters in judge search
	 if (t == "j") { 
			if (j.length < 2){ 
				isFormValid = false;
				$("#j").focus();
			}
			else{
			$(".screendiv").slideFadeToggle();
			$("#searching").slideFadeToggle("fast");
			}
		if (!isFormValid) alert("Please enter at least 2 letters of the judge's name.");
		return isFormValid;
		}
		
//check if there are at least 2 characters in attorney name or numbers in bar search
	 if (t == "a") { 
			if ((f.length < 2 && l.length < 2) && (b.length == 0)){ 
				isFormValid = false;
				$("#f").focus();
			
				if (!isFormValid) alert("Please enter at least 2 letters of the attorney's first or last name --or-- their complete bar number.");
				return isFormValid;
			}

			else if (checkdate == "all" && checkloc == "all") {
				//isFormValid2 = false;
				isFormValid = false;
			
				if (!isFormValid2) alert("Please select a date to search --or-- a location to search.");
				return isFormValid2;
			}

			else{
				$(".screendiv").slideFadeToggle();
				$("#searching").slideFadeToggle("fast");
			}
		return isFormValid;
		}
		
		

});

$(function() {
  $('.loadtoggle').on('click', function() {
	$('.screendiv').slideFadeToggle();
	$('#loadingcal').slideFadeToggle('fast');
    return false;
  });
});



const urlParams = new URLSearchParams(window.location.search);
const myParam = urlParams.get('t');
//alert(myParam); 
$(function() {//alert(myParam)
	if(myParam === 'a') { 
		$('#atty').show(); 
		$('#t option:eq(3)').attr('selected', 'selected'); 
   } else {
		$('#atty').hide(); 
	} 
	if(myParam === 'j') {
		$('#judge').show(); 
		$('#t option:eq(2)').attr('selected', 'selected'); 
	} else {
		$('#party').hide(); 
	} 
	if(myParam === 'p') {
		$('#party').show(); 
		$('#t option:eq(1)').attr('selected', 'selected'); 
	} else {
		$('#party').hide(); 
	} 
	if(myParam === 'c') {
		$('#case').show(); 
		$('#t option:eq(0)').attr('selected', 'selected'); 
	} else {
		$('#case').hide(); 
	} 

	if(myParam == null) {
		$('#case').show(); 
		$('#t option:eq(0)').attr('selected', 'selected'); 
	} 
});
</script>

