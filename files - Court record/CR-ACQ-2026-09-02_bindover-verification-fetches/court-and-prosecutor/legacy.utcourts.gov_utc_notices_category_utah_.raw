	<h1 class="page-title category-archive-title">Category: <span>Utah County</span></h1></header>
	<section id="post-44642" class="post cf post-44642 type-post status-publish format-standard hentry category-utah">
					<!-- Post Header -->	
			<header class="post-header">
				<p class="post-date">Posted: 
					September 1, 2026				</p>
				<aside class="post-author">
					<figure class="author-avatar">
											</figure>
					<p class="author-name">
						<a href="https://legacy.utcourts.gov/utc/notices/author/clerks/">Utah Courts</a>
					</p>
				</aside>
			</header>
		
		<article class="post-content">
			<section class="post-title-wrap cf post-title-wrap-no-image">
				<h2 class="post-title"><a href="https://legacy.utcourts.gov/utc/notices/2026/09/01/utah-county-probate-notices-for-october-5-2026/">Utah County Probate Notices for October 5, 2026</a></h2>
			</section>

			
			<p><a href="http://legacy.utcourts.gov/utc/notices/wp-content/uploads/sites/34/2026/09/263401026_ROJAS_Petition-for-Minors-Name-Change.pdf">263401026_ROJAS_Petition for Minors Name Change</a></p>
<p>Ethan Sebastian Rojas<br />
Janeth Rojas<br />
Diego Baigorria</p>
		</article>
		
		<a href="https://legacy.utcourts.gov/utc/notices/2026/09/01/utah-county-probate-notices-for-october-5-2026/" class="more-link post-button">Continue Reading</a>
	</section>
	<section id="post-44609" class="post cf post-44609 type-post status-publish format-standard hentry category-utah">
					<!-- Post Header -->	
