	<input type="text" id="c" name="c" style="width: 100%;" placeholder="Case Number" value="" />
	</div>

	<div class="col-xs-12 col-sm-5"></div>
</div>

<div id="party">
	<div class="col-xs-12 col-sm-6 left">
	<label for="p">Party Name:</label><br />
	<input type="text" id="p" name="p" style="width: 100%;" placeholder="Party Name" value="" />
	</div>

	<div class="col-xs-12 col-sm-3"></div>
</div>

<div id="judge">
	<div class="col-xs-12 col-sm-6 left">
	<label for="j">Judge Name:</label><br />
	<input type="text" id="j" name="j" style="width: 100%;" placeholder="Judge Name" value="GRAF" />
	</div>

	<div class="col-xs-12 col-sm-3"></div>
</div>  


<div id="atty">
