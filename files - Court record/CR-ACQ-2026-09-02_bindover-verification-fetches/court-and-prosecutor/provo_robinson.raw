<div class="white subhead" style="width: 70%; margin-bottom: 15px;"><p style="font-size: .85em;"><strong>Under <a href="/rules/view.php?type=ucja&rule=4-401.02" style="color: #AFD9EE;">Rule 4-401.02 of the Utah Rules of Judicial Administration</a> court proceedings, including electronic proceedings, may not be recorded, photographed, or transmitted to other devices. A failure to comply with this prohibition may be treated as contempt of court, punishable by a fine or time in jail.</strong></p><p class="right" style="font-size: .85em;"><em class="little white printhide">Court Calendars are updated weekdays at 5:30am.</em></p></div>




<script type="text/javascript" language="javascript">
$(function() {
    $('#party').hide(); 
    $('#judge').hide(); 
	$('#date2').hide(); 
    $('#case').show(); 
    $('#atty').hide(); 
    $('#t').change(function(){
		if($('#t').val() === 'a') {
            $('#atty').show(); 
       } else {
            $('#atty').hide(); 
        } 
		if($('#t').val() === 'p') {
            $('#party').show(); 
        } else {
            $('#party').hide(); 
        } 
		if($('#t').val() === 'j') {
            $('#judge').show(); 
        } else {
            $('#judge').hide(); 
        } 
        if($('#t').val() === 'c') {
            $('#case').show(); 
            $('#party').hide(); 
        } else {
            $('#case').hide(); 
        } 

    });
});
$( document ).ready(function() {
    $("#d").val("all");    
});

$( document ).ready(function() {
    $("#loc").val("2550D");    
});
</script>

